{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lynk",
  "version": "0.1.0",
  "identifier": "app.bloot.lynk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lynk",
        "width": 400,
        "height": 700,
        "minWidth": 400,
        "minHeight": 700,
        "maxWidth": 400,
        "maxHeight": 700,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0A0A0A",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ]
  }
}
