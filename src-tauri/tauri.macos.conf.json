        "theme": "Dark",
        "center": true,
        "visible": false,
        "backgroundColor": "#0A0A0A",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false
    }
  }
}
