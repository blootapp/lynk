{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lynk",
        "width": 400,
        "height": 700,
        "minWidth": 400,
        "minHeight": 700,
        "maxWidth": 400,
        "maxHeight": 700,
        "resizable": false,
        "maximizable": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
